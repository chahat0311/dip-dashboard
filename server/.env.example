# Copy to .env for local work. Never commit .env.
DATABASE_URL=postgres://dip:dip@localhost:5432/dip_dashboard
# Set to true when connecting to a hosted Postgres from outside its network (e.g. Render "External Database URL").
DATABASE_SSL=false
PORT=3000
# Comma-separated list of origins allowed to call the API (the React app's URL).
CORS_ORIGIN=http://localhost:5173
